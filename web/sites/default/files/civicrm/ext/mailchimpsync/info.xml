<?xml version="1.0"?>
<extension key="mailchimpsync" type="module">
  <file>mailchimpsync</file>
  <name>Mailchimp Sync</name>
  <description>A new for 2020 robust mailchimp sync extension for CiviCRM.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Rich Lott / Artful Robot</author>
    <email>code.commits@artfulrobot.uk</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://lab.civicrm.org/extensions/mailchimpsync</url>
    <url desc="Documentation">https://lab.civicrm.org/extensions/mailchimpsync</url>
    <url desc="Support">https://lab.civicrm.org/extensions/mailchimpsync</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-09</releaseDate>
  <version>1.3.3</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.14</ver>
  </compatibility>
  <comments></comments>
  <civix>
    <namespace>CRM/Mailchimpsync</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>ang-php@1.0.0</mixin>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Mailchimpsync\AutomaticUpgrader</upgrader>
</extension>
